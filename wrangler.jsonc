// Cloudflare Worker for savantalent.com. `npm run build` writes the Worker to
// .output/, then `npm run deploy` uploads it. Secrets are set in the Cloudflare
// dashboard (Workers > savantalent > Settings > Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savantalent",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Cloudflare creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "savantalent.com", "custom_domain": true },
    { "pattern": "www.savantalent.com", "custom_domain": true }
  ],
  // Public settings only. Private keys (SUPABASE_SERVICE_ROLE_KEY,
  // ANTHROPIC_API_KEY, RESEND_API_KEY, ...) are Cloudflare secrets.
  "vars": {
    "SUPABASE_URL": "https://auldwzcqtjpwmliqqoyj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ITvSYfXEAJNbxjykI6Ecjg_sGzmo2YJ",
    "RESEND_FROM": "Savant Talent <noreply@savantalent.com>",
    "CONTACT_NOTIFY_TO": "info@savantalent.com"
  }
}
