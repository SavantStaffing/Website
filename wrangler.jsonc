// Cloudflare Worker for savantalent.com. `npm run build` writes the Worker to
// .output/, then `npm run deploy` uploads it. Secrets are set in the Cloudflare
// dashboard (Workers > savantalent > Settings > Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savantalent",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
