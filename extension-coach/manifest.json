{
  "manifest_version": 3,
  "name": "Savant Coach",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "For Savant career coaches: checks a job listing (or a whole Google Sheet of them) for ghost-posting signals and tells you Pass or No pass before you recommend it.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Savant Coach: check this listing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://savantalent.com/*",
    "https://www.savantalent.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.icims.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://jobs.jobvite.com/*",
    "https://www.linkedin.com/jobs/*",
    "https://www.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://www.ziprecruiter.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://savantalent.com/*",
      "https://www.savantalent.com/*",
      "http://localhost/*"
    ]
  }
}
